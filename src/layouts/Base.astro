---
import site from "../content/site.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  wide?: boolean;
}

const {
  title,
  description = `${site.name}, ${site.role} based in ${site.location}`,
  image = site.ogImage,
  noindex = false,
  wide = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const nav = [["Home", "/"], ["Credits", "/credits"], ["About", "/about"], ["Contact", "/contact"]];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  path === href || (href === "/credits" && path.startsWith("/projects/"));

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  url: new URL("/", Astro.site).href,
  sameAs: site.socials.map((s) => s.href),
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0e0e0e" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  {path === "/" && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}

  <style is:global>
    :root { color-scheme: dark; --bg:#0e0e0e; --fg:#e8e8e8; --muted:#888; --max:1100px; }
    body.wide { --max:1320px }
    * { box-sizing:border-box }
    body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.6 system-ui,sans-serif }
    a { color:inherit; text-decoration:none }
    img { max-width:100%; height:auto }
    header, footer { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px 24px; padding:20px 24px; max-width:var(--max); margin:auto }
    nav { display:flex; flex-wrap:wrap; gap:8px 24px }
    nav a { color:var(--muted) } nav a[aria-current] { color:var(--fg) }
    main { max-width:var(--max); margin:auto; padding:24px }
    h1 { font-size:clamp(2rem,5vw,3.5rem); margin:0 0 .25em; line-height:1.1 }
    .hero-title { margin-top:32px }
    .muted { color:var(--muted) }
    .skip { position:absolute; left:-9999px; top:8px; background:var(--fg); color:var(--bg); padding:8px 12px; border-radius:4px; z-index:10 }
    .skip:focus { left:8px }
    a:focus-visible { outline:2px solid var(--fg); outline-offset:3px }

    /* Video + click-to-play facade */
    .video { position:relative; aspect-ratio:16/9; width:100%; background:#000; border-radius:6px; overflow:hidden }
    .video iframe { position:absolute; inset:0; width:100%; height:100%; border:0 }
    .facade { position:absolute; inset:0; display:block }
    .facade img { width:100%; height:100%; object-fit:cover; display:block }
    .play { position:absolute; top:50%; left:50%; width:90px; height:90px; border:2px solid var(--fg); border-radius:50%; background:rgba(0,0,0,.5); backdrop-filter:blur(4px); transform:translate(-50%,-50%); transition:background .3s, transform .3s }
    .play::after { content:""; position:absolute; top:50%; left:50%; border-style:solid; border-width:12px 0 12px 18px; border-color:transparent transparent transparent var(--fg); transform:translate(-38%,-50%) }
    .facade:hover .play, .facade:focus-visible .play { background:var(--fg); transform:translate(-50%,-50%) scale(1.05) }
    .facade:hover .play::after, .facade:focus-visible .play::after { border-left-color:var(--bg) }

    /* Page headings (Credits) */
    .page-header { margin:2rem 0 3rem; text-align:center }
    .page-title { text-transform:uppercase; font-weight:900; letter-spacing:-.02em; margin:0 }
    .empty { text-align:center; margin-top:15vh }

    /* Credits grid */
    .cg-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:3rem }
    .cg-thumb { position:relative; aspect-ratio:16/9; overflow:hidden; background:#0a0a0a; border-radius:6px }
    .cg-thumb img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .8s ease }
    .cg-overlay { position:absolute; inset:0; background:rgba(0,0,0,.2); opacity:0; transition:opacity .5s ease }
    .cg-item:hover img, .cg-item:focus-visible img { transform:scale(1.03) }
    .cg-item:hover .cg-overlay, .cg-item:focus-visible .cg-overlay { opacity:1 }
    .cg-meta { padding-top:1.5rem; text-align:center }
    .cg-meta h2 { margin:0 0 .2rem; font-size:1.5rem; font-weight:900; letter-spacing:-.02em; text-transform:uppercase }
    .cg-meta span { font-size:.85rem; color:var(--muted); text-transform:uppercase; letter-spacing:.05em }

    /* Project pages */
    .intro { margin-top:24px; max-width:70ch }
    .gallery img, .photo { width:100%; display:block; border-radius:6px }
    .gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:12px }
    .two { display:grid; grid-template-columns:1fr 1fr; gap:32px }
    .details { margin-top:40px }
    .links { display:flex; flex-wrap:wrap; gap:8px 20px }
    .kv { display:flex; justify-content:space-between; gap:16px; padding:8px 0; border-bottom:1px solid #222 }

    @media (max-width:700px) {
      .two, .cg-grid { grid-template-columns:1fr }
      .cg-grid { gap:2.5rem }
      .play { width:64px; height:64px }
      .play::after { border-width:9px 0 9px 14px }
    }
    @media (prefers-reduced-motion:reduce) {
      .cg-thumb img, .cg-overlay, .play { transition:none }
      .cg-item:hover img, .cg-item:focus-visible img { transform:none }
    }
  </style>
</head>
<body class={wide ? "wide" : undefined}>
  <a class="skip" href="#main">Skip to content</a>
  <header>
    <a class="logo" href="/">{site.name}</a>
    <nav aria-label="Main">
      {nav.map(([l, h]) => <a href={h} aria-current={isCurrent(h) ? "page" : undefined}>{l}</a>)}
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer>© {new Date().getFullYear()} {site.name}</footer>
</body>
</html>