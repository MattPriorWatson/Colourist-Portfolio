---
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Video from "../components/Video.astro";
import site from "../content/site.json";

// Hero image for the reel: src/assets/reel-poster.webp.
// If the file doesn't exist, the build still passes but the hero is a plain black screen with a play button.
const posters = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/reel-poster.{webp,jpg,jpeg,png,avif}",
);
const loadPoster = Object.values(posters)[0];
const reelPoster = loadPoster ? (await loadPoster()).default : undefined;
---
<Base bare>
  <Video {...site.reel} title="Showreel" poster={reelPoster} variant="hero">
    <h1 class="hero-subtitle"><span class="sr-only">{site.name}, </span>{site.role}</h1>
  </Video>
</Base>