---
import Base from "../../layouts/Base.astro";
import Video from "../../components/Video.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { data: p } = Astro.props.project;
---
<Base title={p.title} description={p.bio}>
  <h1>{p.title}</h1>
  <p class="muted">{p.subtitle}{p.year && ` · ${p.year}`}{p.role && ` · ${p.role}`}</p>
  <Video {...p.video} title={p.title} />
  {p.bio && <p style="margin-top:24px;max-width:70ch">{p.bio}</p>}

  {p.gallery.length > 0 && (<>
    <h2>Gallery</h2>
    <div class="gallery">{p.gallery.map((g) => <img src={g.src} alt={g.alt} loading="lazy" />)}</div>
  </>)}

  <div class="two" style="margin-top:40px">
    {p.credits.length > 0 && (
      <section><h2>Credits</h2>
        {p.credits.map((c) => <div class="kv"><span class="muted">{c.role}</span><span>{c.name}</span></div>)}
      </section>
    )}
    {p.awards.length > 0 && (
      <section><h2>Awards</h2>
        {p.awards.map((a) => <div class="kv"><span class="muted">{a.year}</span><span>{a.name}{a.note && ` · ${a.note}`}</span></div>)}
      </section>
    )}
  </div>
</Base>