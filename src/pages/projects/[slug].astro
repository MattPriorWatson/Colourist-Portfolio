---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Video from "../../components/Video.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { data: p } = Astro.props.project;
const meta = [p.subtitle, p.year, p.role].filter(Boolean).join(" · ");
---
<Base title={p.title} description={p.bio} bare>
  <div class="pad pad-top">
    <div class="project-header fade-up">
      <h1>{p.title}</h1>
      <span class="text-small">{meta}</span>
    </div>
  </div>

  <Video {...p.video} title={p.title} poster={p.thumbnail} variant="banner" />

  <div class="pad pad-bottom">
    {p.credits.length > 0 && (
      <div class="meta-grid fade-up">
        {p.credits.map((c) => <div class="meta-item"><span>{c.role}</span><p>{c.name}</p></div>)}
      </div>
    )}

    {p.bio && <p class="project-description fade-up">{p.bio}</p>}

    {p.gallery.length > 0 && (
      <div class="project-gallery">
        {p.gallery.map((g) => <Image class="fade-up" src={g.src} alt={g.alt} width={1200} />)}
      </div>
    )}

    {p.awards.length > 0 && (
      <div class="awards fade-up">
        <span class="text-small label">Awards &amp; Nominations</span>
        {p.awards.map((a) => <p>{a.year} · {a.name}{a.note && ` · ${a.note}`}</p>)}
      </div>
    )}
  </div>
</Base>