---
import Base from "../layouts/Base.astro";
import site from "../content/site.json";
---
<Base title="About" description={`About ${site.name}, ${site.role} based in ${site.location}.`}>
  <div class="two">
    <img src={site.about.photo} alt={site.name} style="width:100%;border-radius:6px" />
    <div>
      <h1>About</h1>
      {site.about.bio.map((p) => <p>{p}</p>)}
    </div>
  </div>
</Base>