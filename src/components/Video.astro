---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  provider: "youtube" | "vimeo";
  id: string;
  hash?: string;
  title?: string;
  poster?: ImageMetadata;
}

const { provider, id, hash, title = "Video", poster } = Astro.props;

const embed =
  provider === "vimeo"
    ? `https://player.vimeo.com/video/${id}?${hash ? `h=${hash}&` : ""}dnt=1&autoplay=1`
    : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;

const watch =
  provider === "vimeo"
    ? `https://vimeo.com/${id}${hash ? `/${hash}` : ""}`
    : `https://www.youtube.com/watch?v=${id}`;
---
<div class="video">
  <a class="facade" href={watch} data-embed={embed} data-title={title} aria-label={`Play ${title}`}>
    {poster && <Image src={poster} alt="" width={1600} loading="eager" fetchpriority="high" />}
    <span class="play" aria-hidden="true"></span>
  </a>
</div>
<script is:inline src="/video-facade.js"></script>