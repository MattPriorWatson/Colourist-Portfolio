---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  provider: "youtube" | "vimeo";
  id: string;
  hash?: string;
  title?: string;
  poster?: ImageMetadata;
  variant?: "hero" | "banner";
}

const { provider, id, hash, title = "Video", poster, variant = "banner" } = Astro.props;

const embed =
  provider === "vimeo"
    ? `https://player.vimeo.com/video/${id}?${hash ? `h=${hash}&` : ""}dnt=1&autoplay=1`
    : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;

const watch =
  provider === "vimeo"
    ? `https://vimeo.com/${id}${hash ? `/${hash}` : ""}`
    : `https://www.youtube.com/watch?v=${id}`;
---
<div class={`player ${variant}`} data-player>
  <a class="facade" href={watch} data-embed={embed} data-title={title} aria-label={`Play ${title}`}>
    {poster && (
      <Image src={poster} alt="" widths={[800, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
    )}
    {variant === "hero" && <span class="vignette" aria-hidden="true"></span>}
    <span class="play" aria-hidden="true"></span>
  </a>
  <slot />
</div>
<script is:inline src="/video-facade.js"></script>