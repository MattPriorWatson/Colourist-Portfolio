---
interface Props {
  provider: "youtube" | "vimeo";
  id: string;
  hash?: string;
  title?: string;
  lazy?: boolean;
}

const { provider, id, hash, title = "Video", lazy = true } = Astro.props;
const src =
  provider === "vimeo"
    ? `https://player.vimeo.com/video/${id}?${hash ? `h=${hash}&` : ""}dnt=1`
    : `https://www.youtube-nocookie.com/embed/${id}`;
---
<div class="video">
  <iframe src={src} title={title} loading={lazy ? "lazy" : "eager"} allowfullscreen
    allow="autoplay; fullscreen; picture-in-picture"></iframe>
</div>